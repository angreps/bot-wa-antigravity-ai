# Nomor WhatsApp Pemilik (Gunakan kode negara tanpa +, contoh: 6281234567890)
# Bisa lebih dari 1 nomor dipisahkan koma: 6281234567890,6289876543210
OWNER_NUMBER=628xxxxxxxxxxx

# Nomor WhatsApp Bot
BOT_NUMBER=628xxxxxxxxxxx

# Mode Selfbot (true = HANYA merespons Owner, abaikan orang lain tanpa balasan)
SELFBOT_MODE=true

# Otomatis baca chat masuk (centang biru) agar tidak ada notifikasi menumpuk di HP
AUTO_READ=true

# Mode Pairing Code (true = pakai kode angka 8 digit, false = scan QR code terminal)
USE_PAIRING_CODE=true

# Prefix perintah terminal & kontrol (default: !)
COMMAND_PREFIX=!

# Direktori kerja default untuk PowerShell & Antigravity (C:\Users\Administrator\Downloads\bot-rcon)
DEFAULT_CWD=C:\Users\Administrator\Downloads\bot-rcon

# Path binary agy.exe jika tidak berada di lokasi default
AGY_PATH=C:\Users\Administrator\AppData\Local\agy\bin\agy.exe

# Model AI Antigravity opsional (kosongkan untuk default sesi laptop)
# Contoh: gemini-3.1-pro-high, gemini-3.8-flash-high, claude-sonnet-5-5-high
AGY_MODEL=

# Port WebSocket server bawaan (default: 8765)
WS_PORT=8765
